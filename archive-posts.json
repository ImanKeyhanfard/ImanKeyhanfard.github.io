{% assign posts = "" | split: "" %}
{% for pair in site.data.archive_posts %}
  {% assign posts = posts | push: pair[1] %}
{% endfor %}
{% assign posts = posts | sort: "date" | reverse %}
[
{% for post in posts %}
  {{ post | jsonify }}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
